# AscendC Operator Knowledge Base

# === ChromaDB配置 ===
CHROMA_DB_PATH=./data/chroma_db

# === Redis配置 ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# === LLM配置（用于知识抽取） ===
# 选择其中一种或多种

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_API_BASE=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI
# OPENAI_API_KEY=sk-xxx
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Zhipu (智谱)
# ZHIPU_API_KEY=your_zhipu_api_key
# ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-4

# MiniMax
# MINIMAX_API_KEY=your_minimax_api_key
# MINIMAX_API_BASE=https://api.minimax.chat/v1
# MINIMAX_GROUP_ID=your_group_id
# MINIMAX_MODEL=MiniMax-Text-01

# 默认 Provider: anthropic, openai, zhipu, minimax
# DEFAULT_PROVIDER=anthropic

# === 向量化模型 ===
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B

# === 服务配置 ===
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# === 数据源配置 ===
# 昇腾算子仓Webhook（可选）
# WEBHOOK_SECRET=your-webhook-secret

# === GitCode配置 ===
# GitCode Access Token (可选，登录 https://gitcode.com 获取)
# GITCODE_TOKEN=your_gitcode_token
# GitCode仓库配置文件路径 (YAML格式)
# GITCODE_REPOS_FILE=./repos.yaml

# === GitHub配置 ===
# GitHub Personal Access Token (可选，无 token 限流 60 req/hr)
# GITHUB_TOKEN=your_github_token
# GitHub仓库配置文件路径 (YAML格式)
# GITHUB_REPOS_FILE=./repos.yaml

# === 可选：外部服务 ===
# REDIS_SENTINEL_HOSTS=localhost:26379
# REDIS_SENTINEL_MASTER=sentinel-master
